{
  "name": "free-model-gateway",
  "version": "1.2.2",
  "private": true,
  "description": "免费大模型聚合代理网关：把散落在各家平台的免费模型额度汇总成一个 OpenAI 兼容入口，集中提供给任意 AI 客户端调用。",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "test": "node scripts/selfcheck.js && node scripts/test-updater.js && node tools/gen-eula-doc.js --check",
    "selfcheck": "node scripts/selfcheck.js",
    "test:updater": "node scripts/test-updater.js",
    "ui-smoke": "node scripts/ui-smoke.js",
    "eula:doc": "node tools/gen-eula-doc.js",
    "eula:check": "node tools/gen-eula-doc.js --check",
    "discover": "node scripts/discover.js",
    "seed-demo": "node scripts/seed-demo.js",
    "reset-data": "node scripts/reset-data.js",
    "build:fpk": "python tools/build_fpk.py",
    "verify:fpk": "python tools/verify_fpk.py",
    "icons": "python tools/make_icons.py",
    "update:pack": "node tools/make-update.js",
    "update:publish": "node tools/make-update.js --publish",
    "release": "python tools/build_fpk.py && node tools/make-update.js"
  },
  "dependencies": {},
  "keywords": [
    "openai-compatible",
    "llm-gateway",
    "free-models",
    "proxy",
    "api-aggregator"
  ],
  "license": "MIT"
}
